# Training runs: checkpoints and replay buffers, hundreds of MB to GB.
runs/

# Generated engine bundles. Rebuild with: python package_engine.py
engines/

# Scratch used when migrating a run between cloud providers.
beam_seed/
logo_b64.txt

# Staging for checkpoints uploaded to a Beam volume (hundreds of MB).
beam_stage/

# Staging folders built by kaggle_setup.py
kaggle_upload/
kaggle_notebook/

# Beam syncs the working directory to its containers; this is its ignore file,
# not something a cloner needs.
.beamignore

*.log
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.DS_Store
Thumbs.db
